<b-heading text="{{heading}}"></b-heading>
  <div class="tw:flex tw:w-full tw:h-full tw:justify-center">
    <div class="tw:rounded-2xl tw:bg-secondary-1200 tw:p-8 tw:w-lg">
      <form action="/admin/portal/passwordrecovery" method="POST" class="tw:space-y-4 tw:my-5">
        <b-paragraph text="If you have forgotten your website login password, fill this page in with your registered user ID."></b-paragraph> 
        <b-input for="Username" label="Enter your User ID" dataType="text" dataVal="true" dataValLength="The field Username must be a string with a maximum length of 100." dataValLengthMax="100" maxLength="100" id="Username" name="Username"></b-input>
            
            <div class="g-recaptcha tw:my-4"
              data-sitekey="6LfwwIQqAAAAANcF-qB9oAxVzaVwIum45H588zwK"
              data-callback="onSubmit"
              data-badge="inline"
              data-size="invisible">
            </div>
            <b-button type="submit" text="Submit" classes="tw:w-full tw:bg-black-1000 tw:text-white-1000 tw:hover:bg-tertiary-500 tw:hover:text-black-1000"></b-button>
            <b-link href="/admin/portal/login" text="Cancel" class="tw:text-center tw:block tw:my-4"></b-link>
          </form>
        </div>
      </div>      