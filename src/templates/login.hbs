<b-heading text="{{heading}}"></b-heading>
  <div class="tw:flex tw:w-full tw:h-full tw:justify-center">
    <div class="tw:rounded-2xl tw:bg-secondary-1200 tw:p-8 tw:w-lg">
      <form action="/admin/portal/login" method="post" autocomplete="disable-autocomplete" class="tw:space-y-4 tw:my-5">
        <b-input label="User ID" for="Username" dataVal="true" maxlength="100" dataType="text" id="Username" name="Username" dataValLength="The field Username must be a string with a maximum length of 100." dataValLengthMax="100"></b-input>
        <b-input label="Password" for="Password" dataVal="true" maxlength="100" dataType="password" id="Password" name="Password" dataValLength="The field Password must be a string with a maximum length of 50." dataValLengthMax="50"></b-input>
          <div class="g-recaptcha tw:my-4"
            data-sitekey="6LfwwIQqAAAAANcF-qB9oAxVzaVwIum45H588zwK"
            data-callback="onSubmit"
            data-badge="inline"
            data-size="invisible">
          </div>
          <b-button type="submit" text="Sign In" classes="tw:w-full tw:bg-black-1000 tw:text-white-1000 tw:hover:bg-tertiary-500 tw:hover:text-black-1000"></b-button>
        </form>
      </div>
    </div>