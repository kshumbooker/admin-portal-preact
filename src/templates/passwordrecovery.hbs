<b-heading text="{{heading}}"></b-heading>
  <div class="tw:flex tw:w-full tw:h-full tw:justify-center">
    <div class="tw:rounded-2xl tw:bg-secondary-1200 tw:p-8 tw:w-lg">
      <form action="/admin/portal/passwordrecovery" method="POST" class="tw:space-y-4 tw:my-5">
        <b-paragraph text="{{paragraph}}"></b-paragraph>
            
        <div class="g-recaptcha tw:my-4"
          data-sitekey="6LfwwIQqAAAAANcF-qB9oAxVzaVwIum45H588zwK"
          data-callback="onSubmit"
          data-badge="inline"
          data-size="invisible">
        </div>
          
        <b-button type="{{button.type}}" href="{{button.href}}" class="tw:w-full tw:my-4 tw:no-underline tw:inline-flex tw:text-center tw:items-center tw:justify-center tw:rounded-[120px] tw:focus:outline-hidden tw:transition-all tw:leading-none tw:font-medium tw:px-4 tw:py-3 tw:text-lg tw:bg-black-1000 tw:text-white-1000 tw:cursor-pointer tw:hover:bg-tertiary-500 tw:hover:text-black-1000 tw:no-underline" text="{{button.text}}"></b-button>
      </form>
    </div>
  </div>