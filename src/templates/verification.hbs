<b-heading text="{{heading}}"></b-heading>
<div class="tw:flex tw:w-full tw:h-full tw:justify-center">
  <div class="tw:rounded-2xl tw:bg-secondary-1200 tw:p-8 tw:w-lg">
    <form method="post" autocomplete="disable-autocomplete" class="tw:space-y-4 tw:my-5">
      <b-paragraph text="{{paragraph}}"></b-paragraph>

      <b-link href="#" id="sendCode" text="Click here to send a new code"></b-link>
      <b-alert type="{{alert1.type}}" msg="{{alert1.msg}}"></b-alert>
      
      <b-alert type="{{alert2.type}}" msg="{{alert2.msg}}"></b-alert>

      <b-input label="Verification Code" for="Verification" dataType="text" id="Verification" name="Verification"></b-input>

      <b-button type="submit" text="Verify" classes="tw:w-full tw:bg-black-1000 tw:text-white-1000 tw:hover:bg-tertiary-500 tw:hover:text-black-1000"></b-button>
      
      <b-link href="/admin/portal/login?action=cancel" text="Cancel" class="tw:text-center tw:block tw:my-4"></b-link>
    </form>
  </div>
</div>      